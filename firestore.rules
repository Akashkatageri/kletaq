rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =============================================================
    // HELPER FUNCTIONS
    // =============================================================
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegativeNumber(val) {
      return (val is int || val is number) && val >= 0;
    }

    // =============================================================
    // USERS COLLECTION & SUBCOLLECTIONS
    // =============================================================
    match /users/{userId} {
      // Authenticated users can view basic profiles for classmate interaction/social feed
      allow read: if isAuthenticated();

      // Creation, updates, and deletion strictly restricted to the account owner
      allow create: if isOwner(userId)
        && (!('uid' in request.resource.data) || request.resource.data.uid == userId);

      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);

      // --- Private Academic & Personal Subcollections (Owner Only) ---
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
      match /module_notes/{moduleId} {
        allow read, write: if isOwner(userId);
      }
      match /memory_cards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      match /topic_flashcards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      match /revisions/{revId} {
        allow read, write: if isOwner(userId);
      }
      match /topicChats/{chatId} {
        allow read, write: if isOwner(userId);
        match /messages/{msgId} {
          allow read, write: if isOwner(userId);
        }
      }
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      match /backlogPlans/{planId} {
        allow read, write: if isOwner(userId);
      }
      match /habit_archives/{monthKey} {
        allow read, write: if isOwner(userId);
      }
      match /completedModules/{modId} {
        allow read, write: if isOwner(userId);
      }
      match /completedSubtopics/{subId} {
        allow read, write: if isOwner(userId);
      }
      match /completedTopics/{topId} {
        allow read, write: if isOwner(userId);
      }
      match /questProgress/{questId} {
        allow read, write: if isOwner(userId);
      }
      match /roadmapPosition/{posId} {
        allow read, write: if isOwner(userId);
      }
      match /achievements/{achId} {
        allow read, write: if isOwner(userId);
      }
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /processedSessions/{sessId} {
        allow read, write: if isOwner(userId);
      }
      match /xpHistory/{histId} {
        allow read, write: if isOwner(userId);
      }
      match /exams/{examId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // --- Social Subcollections ---
      // Friends list: owner has full control, friend can verify friendship status
      match /friends/{friendUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendUid);
        allow write: if isOwner(userId);
      }

      // Friend requests: target reads/manages, sender can send and cancel request
      match /friend_requests/{senderUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == senderUid);
        allow create: if isAuthenticated() && request.auth.uid == senderUid;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == senderUid);
      }

      // In-app notifications: target user manages; authenticated users can send cheers or friend requests
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        allow create: if isAuthenticated();
      }
    }

    // =============================================================
    // STATS COLLECTION (Gamification, XP, Streaks)
    // Document ID matches user UID
    // =============================================================
    match /stats/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && (!('xp' in request.resource.data) || isNonNegativeNumber(request.resource.data.xp))
        && (!('totalXp' in request.resource.data) || isNonNegativeNumber(request.resource.data.totalXp));

      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // =============================================================
    // SEMESTER STATS (Archived Semester Academic Records)
    // Document ID pattern: {uid}_sem{semesterId}
    // =============================================================
    match /semesterStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && statId.matches('^' + request.auth.uid + '_sem[1-8]$');
    }

    // =============================================================
    // USERNAMES COLLECTION (Unique Handle Claiming)
    // =============================================================
    match /usernames/{username} {
      allow read: if isAuthenticated();

      // Only claim if document doesn't exist yet and username is valid
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && username.matches('^[a-z0-9_.-]{3,30}$');

      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =============================================================
    // ACTIVITIES COLLECTION (Live Feed & Cheers)
    // =============================================================
    match /activities/{activityId} {
      allow read: if isAuthenticated();

      // Activity author must be current authenticated user
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid;

      // Author can edit/delete, classmates can send a cheer (+1 count, append their UID)
      allow update: if isAuthenticated() && (
        (resource.data.uid == request.auth.uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheerCount', 'cheeredUserIds'])
          && request.resource.data.cheerCount == resource.data.cheerCount + 1
          && request.resource.data.cheeredUserIds.hasAll(resource.data.cheeredUserIds)
          && request.resource.data.cheeredUserIds.size() == resource.data.cheeredUserIds.size() + 1
          && !(request.auth.uid in resource.data.cheeredUserIds)
          && (request.auth.uid in request.resource.data.cheeredUserIds)
        )
      );

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // =============================================================
    // LEADERBOARDS COLLECTION (Rankings)
    // =============================================================
    match /leaderboards/{leagueId}/entries/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId);
    }

    // =============================================================
    // MODEL PAPERS CACHE (Solved VTU Question Papers)
    // =============================================================
    match /model_papers/{paperId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
