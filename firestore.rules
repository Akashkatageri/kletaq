rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isNonNegativeInt(val) {
      return (val is int || val is number) && val >= 0;
    }

    // -------------------------------------------------------------
    // USERS COLLECTION
    // -------------------------------------------------------------
    match /users/{userId} {
      // Any authenticated user can view classmate profiles for social/friends,
      // but write is strictly owner-only.
      allow read: if isAuthenticated();
      
      allow create: if isOwner(userId) 
        && request.resource.data.keys().hasAll(['uid'])
        && request.resource.data.uid == userId;

      allow update: if isOwner(userId)
        && request.resource.data.uid == userId;

      allow delete: if isOwner(userId);

      // --- Private subcollections (Owner Only) ---
      match /memory_cards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      match /topicChats/{chatId} {
        allow read, write: if isOwner(userId);
        match /messages/{msgId} {
          allow read, write: if isOwner(userId);
        }
      }
      match /backlogPlans/{planId} {
        allow read, write: if isOwner(userId);
      }
      match /habit_archives/{monthKey} {
        allow read, write: if isOwner(userId);
      }
      match /completedModules/{modId} {
        allow read, write: if isOwner(userId);
      }
      match /completedSubtopics/{subId} {
        allow read, write: if isOwner(userId);
      }
      match /completedTopics/{topId} {
        allow read, write: if isOwner(userId);
      }
      match /questProgress/{questId} {
        allow read, write: if isOwner(userId);
      }
      match /revisions/{revId} {
        allow read, write: if isOwner(userId);
      }
      match /roadmapPosition/{posId} {
        allow read, write: if isOwner(userId);
      }
      match /tasks/{taskId} {
        allow read, write: if isOwner(userId);
      }
      match /notes/{noteId} {
        allow read, write: if isOwner(userId);
      }
      match /module_notes/{moduleId} {
        allow read, write: if isOwner(userId);
      }
      match /achievements/{achId} {
        allow read, write: if isOwner(userId);
      }
      match /entries/{entryId} {
        allow read, write: if isOwner(userId);
      }
      match /processedSessions/{sessId} {
        allow read, write: if isOwner(userId);
      }
      match /xpHistory/{histId} {
        allow read, write: if isOwner(userId);
      }
      match /topic_flashcards/{cardId} {
        allow read, write: if isOwner(userId);
      }
      match /exams/{examId} {
        allow read, write: if isOwner(userId);
      }
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      // --- Friends Subcollection ---
      // A user manages their own friends list; friends can check status
      match /friends/{friendUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == friendUid);
        allow write: if isOwner(userId);
      }

      // --- Friend Requests Subcollection ---
      // Target user receives requests; sender writes their own request
      match /friend_requests/{senderUid} {
        allow read: if isOwner(userId) || (isAuthenticated() && request.auth.uid == senderUid);
        allow create: if isAuthenticated() 
          && request.auth.uid == senderUid
          && request.resource.data.uid == senderUid;
        allow delete: if isOwner(userId) || (isAuthenticated() && request.auth.uid == senderUid);
      }

      // --- Notifications Subcollection ---
      match /notifications/{notifId} {
        allow read, update, delete: if isOwner(userId);
        // Authenticated users can send friend_request or cheer notifications to target user
        allow create: if isAuthenticated() 
          && request.resource.data.entityId == request.auth.uid
          && isValidString(request.resource.data.title, 1, 100)
          && isValidString(request.resource.data.message, 1, 500);
      }
    }

    // -------------------------------------------------------------
    // STATS COLLECTION (Gamification, XP, Streaks)
    // -------------------------------------------------------------
    match /stats/{userId} {
      allow read: if isAuthenticated();

      allow create: if isOwner(userId)
        && isNonNegativeInt(request.resource.data.totalXp)
        && request.resource.data.totalXp <= 500; // Reasonable starting cap

      allow update: if isOwner(userId)
        // Anti-Cheat: XP cannot decrease
        && request.resource.data.totalXp >= resource.data.totalXp
        // Anti-Cheat: Prevent single-update XP explosion (> 10,000 XP in one write)
        && request.resource.data.totalXp <= resource.data.totalXp + 10000
        // Streak sanity check: streak cannot jump by more than +1
        && request.resource.data.effectiveStreak <= resource.data.effectiveStreak + 1;

      allow delete: if isOwner(userId);
    }

    // -------------------------------------------------------------
    // SEMESTER STATS (Archived Semester Academic Records)
    // Document ID pattern: {uid}_sem{semesterId}
    // -------------------------------------------------------------
    match /semesterStats/{statId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && statId.matches('^' + request.auth.uid + '_sem[1-8]$');
    }

    // -------------------------------------------------------------
    // USERNAMES COLLECTION (Unique Handle Claiming)
    // -------------------------------------------------------------
    match /usernames/{username} {
      allow read: if isAuthenticated();
      
      // Prevent Username Hijacking: Can only claim if document doesn't exist yet
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(username))
        && username.matches('^[a-z0-9_.-]{3,30}$');

      // Only owner can update or delete their claimed username
      allow update, delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // ACTIVITIES COLLECTION (Classmate Live Study Feed & Cheers)
    // -------------------------------------------------------------
    match /activities/{activityId} {
      allow read: if isAuthenticated();

      // Creating a new study activity: Must be the author
      allow create: if isAuthenticated()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cheerCount == 0
        && request.resource.data.cheeredUserIds.size() == 0
        && isValidString(request.resource.data.title, 1, 100);

      // Updating an activity:
      // Case A: Author updates their own activity
      // Case B: Classmate sends a cheer (+1 count, appends their UID)
      allow update: if isAuthenticated() && (
        (resource.data.uid == request.auth.uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cheerCount', 'cheeredUserIds'])
          && request.resource.data.cheerCount == resource.data.cheerCount + 1
          && request.resource.data.cheeredUserIds.hasAll(resource.data.cheeredUserIds)
          && request.resource.data.cheeredUserIds.size() == resource.data.cheeredUserIds.size() + 1
          && !(request.auth.uid in resource.data.cheeredUserIds)
          && (request.auth.uid in request.resource.data.cheeredUserIds)
        )
      );

      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // -------------------------------------------------------------
    // LEADERBOARDS COLLECTION (Competitive Ranking)
    // -------------------------------------------------------------
    match /leaderboards/{leagueId}/entries/{userId} {
      allow read: if isAuthenticated();
      allow write: if isOwner(userId) && request.resource.data.uid == userId;
    }

    // -------------------------------------------------------------
    // MODEL PAPERS CACHE (VTU Question Papers & AI Solutions)
    // -------------------------------------------------------------
    match /model_papers/{paperId} {
      allow read: if isAuthenticated();
      // Only authenticated users can contribute solved model papers with schema limits
      allow write: if isAuthenticated()
        && isValidString(request.resource.data.vtuCode, 1, 20)
        && isValidString(request.resource.data.subjectTitle, 1, 100);
    }
  }
}
